# Configuration publique, intégrée à l'image lors du build
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Configuration du serveur au démarrage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

# Image présente sur la machine de déploiement
MEDLINK_IMAGE=medlink:ci-3

# Utiliser 192.168.33.10 pour la démonstration dans votre VM
MEDLINK_BIND_IP=127.0.0.1